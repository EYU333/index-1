<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>小学实验小助手 | 科学电学实验站</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent; /* 移除触摸灰层 */
        }

        body {
            font-family: 'Segoe UI', 'Comic Neue', 'Poppins', system-ui, -apple-system, 'Roboto', sans-serif;
            background: linear-gradient(145deg, #fef7e8 0%, #fff3e0 100%);
            color: #2d3e2b;
            padding: 1rem;
            min-height: 100vh;
        }

        /* 手绘背景修饰 */
        .bg-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.06;
            pointer-events: none;
            background-image: radial-gradient(circle at 10px 10px, #f5a623 1.2px, transparent 1px);
            background-size: 28px 28px;
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        /* 头部区域 */
        .hero {
            text-align: center;
            margin-bottom: 2rem;
            padding: 1.5rem 1rem;
            background: rgba(255, 250, 240, 0.8);
            border-radius: 70px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.04);
            backdrop-filter: blur(2px);
        }

        .hero h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #ff8c42, #f7b05e, #ffce7a);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            display: inline-flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .hero h1 i {
            background: none;
            color: #ffaa44;
            font-size: 2.4rem;
        }

        .sub {
            background: #fff1e2;
            display: inline-block;
            padding: 0.5rem 1.8rem;
            border-radius: 60px;
            margin-top: 0.8rem;
            font-weight: 600;
            color: #b45f2b;
            font-size: 1.1rem;
        }

        .safety-card {
            background: #ffebd2;
            border-radius: 40px;
            padding: 0.8rem 1.2rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            border-left: 10px solid #f57c00;
            font-weight: 500;
        }

        /* 实验网格 — 加大按钮间距和触摸区域 */
        .experiment-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
            margin: 2rem 0 2rem;
        }

        /* 卡片整体 —— 大触摸区域 + 独立info按钮 */
        .exp-card {
            background: #ffffff;
            border-radius: 48px;
            box-shadow: 0 20px 28px -14px rgba(0, 0, 0, 0.15);
            transition: transform 0.2s ease, box-shadow 0.2s;
            border: 1px solid rgba(253, 190, 98, 0.5);
            position: relative;
            display: flex;
            flex-direction: column;
            /* 保证卡片内内容结构清晰 */
        }

        .exp-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 35px -16px rgba(0, 0, 0, 0.2);
            border-color: #ffb347;
        }

        /* 主链接区域 (占满绝大部分卡片，除了info按钮区域) */
        .card-main-link {
            text-decoration: none;
            color: inherit;
            display: block;
            padding: 1.8rem 1.8rem 2rem 1.8rem;
            border-radius: 48px;
            flex: 1;
            transition: background 0.2s;
        }

        /* 图标样式 — 更大更醒目 */
        .exp-icon {
            font-size: 3.8rem;
            background: #fef0e0;
            width: 85px;
            height: 85px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 45px;
            margin-bottom: 1rem;
            color: #e67e22;
            transition: all 0.2s ease;
        }

        .exp-card:hover .exp-icon {
            background: #ffe0bf;
            transform: scale(0.97);
        }

        .exp-title {
            font-size: 1.9rem;
            font-weight: 800;
            margin: 0.7rem 0 0.2rem;
            color: #3c2a12;
            letter-spacing: -0.3px;
            line-height: 1.2;
        }

        /* 简介段落默认隐藏，鼠标悬浮在卡片上显示 (符合鼠标指到才出现) */
        .exp-desc {
            font-size: 1rem;
            line-height: 1.45;
            color: #5a4b30;
            margin-top: 1rem;
            display: none;
            background: #fff6ea;
            padding: 0.9rem 1rem;
            border-radius: 28px;
            transition: all 0.2s;
        }

        .exp-card:hover .exp-desc,
        .exp-card:active .exp-desc {
            display: block;
        }

        /* 辅助信息按钮: 独立小圆钮，用于触摸设备点击查看简介 (不干扰链接跳转) */
        .info-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: #ffffffcc;
            backdrop-filter: blur(8px);
            width: 44px;
            height: 44px;
            border-radius: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #f58a2e;
            cursor: pointer;
            z-index: 15;
            transition: 0.2s;
            border: 1px solid #ffcd94;
            box-shadow: 0 3px 8px rgba(0,0,0,0.05);
        }

        .info-btn:hover {
            background: #ffdbb5;
            transform: scale(1.05);
        }

        /* 为了让触摸时不会误触主链接，info按钮单独阻止冒泡 */
        .info-btn i {
            pointer-events: none; /* 让图标不干扰点击，但按钮本身可点击 */
        }

        /* 右下角装饰小箭头 */
        .arrow-hint {
            margin-top: 0.8rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #ed8936;
            background: #fff0e0;
            padding: 0.3rem 1rem;
            border-radius: 60px;
            font-size: 0.85rem;
        }

        /* Toast 轻提示样式 (点击info展示简介) */
        .toast-message {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) scale(0.9);
            background: #2c3e2b;
            color: #fff7e8;
            padding: 12px 24px;
            border-radius: 60px;
            font-size: 1rem;
            font-weight: 500;
            max-width: 85vw;
            text-align: center;
            z-index: 1000;
            box-shadow: 0 12px 25px rgba(0,0,0,0.2);
            backdrop-filter: blur(8px);
            background: rgba(38, 50, 32, 0.92);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s, transform 0.2s;
            font-family: monospace;
            line-height: 1.4;
        }

        .toast-message.show {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }

        /* 编辑提示栏 */
        .edit-tip {
            background: #eef3fc;
            border-radius: 36px;
            padding: 1rem 1.5rem;
            margin: 1.5rem 0 1rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            border: 1px dashed #f9b43a;
            font-size: 0.9rem;
            color: #2c5778;
        }

        .edit-tip i {
            font-size: 1.6rem;
            color: #ff9f4a;
        }

        .footer {
            text-align: center;
            margin-top: 2.5rem;
            padding: 1rem;
            font-size: 0.8rem;
            color: #aa7942;
            border-top: 2px dotted #ffcf9a;
        }

        /* 触摸优化 */
        @media (max-width: 700px) {
            body {
                padding: 0.8rem;
            }
            .hero h1 {
                font-size: 1.9rem;
            }
            .exp-title {
                font-size: 1.6rem;
            }
            .exp-icon {
                width: 70px;
                height: 70px;
                font-size: 3rem;
            }
            .card-main-link {
                padding: 1.2rem 1.2rem 1.5rem 1.2rem;
            }
            .info-btn {
                width: 40px;
                height: 40px;
                top: 14px;
                right: 14px;
                font-size: 1.3rem;
            }
            .experiment-grid {
                gap: 1.5rem;
            }
        }

        /* 确保触摸设备上点击info不会触发上层链接的跳转 */
        .info-btn:active {
            background-color: #ffbf7a;
        }

        /* 简介里强调趣味 */
        .exp-desc i {
            margin-right: 6px;
            color: #f5a623;
        }
    </style>
</head>
<body>
<div class="bg-pattern"></div>
<div class="container">
    <!-- 头部区 -->
    <div class="hero">
        <h1>
            <i class="fas fa-flask"></i>
            小学实验小助手
            <i class="fas fa-lightbulb"></i>
        </h1>
        <div class="sub">
            <i class="fas fa-bolt"></i> 触摸大实验 · 安全趣探索
        </div>
        <p style="margin-top: 12px; color: #b56225; max-width: 500px; margin-left: auto; margin-right: auto;">
            🧪 每一个卡片都是一个实验大门，点击卡片直接进入学习。<br>
