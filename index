        </div>

        <!-- 5：虚拟电路组建实验 -->
        <div class="exp-card" data-desc="💻 线上模拟平台搭电路，拖拽电池、导线、灯泡，实时观察电流。安全无风险，自由组合乐无穷！">
            <a href="virtual-circuit-lab.html" class="card-main-link" id="link5">
                <div class="exp-icon"><i class="fas fa-microchip"></i></div>
                <div class="exp-title">🖥️ 5. 虚拟电路组建实验</div>
                <div class="exp-desc">
                    <i class="fas fa-laptop-code"></i> 虚拟电学实验室，探索电路搭建，点亮属于你的虚拟世界。
                </div>
                <div class="arrow-hint"><i class="fas fa-hand-point-right"></i> 点击学习</div>
            </a>
            <div class="info-btn" data-desc-index="4"><i class="fas fa-info-circle"></i></div>
        </div>
    </div>

    <!-- 提示框：方便教师替换链接 -->
    <div class="edit-tip">
        <i class="fas fa-pen-fancy"></i>
        <div style="flex:1;">
            📌 <strong>自定义实验链接</strong> — 当前5个卡片链接地址分别为：<br>
            <code>bulb-structure.html</code> 、<code>experiment-operation.html</code> 、<code>light-rules.html</code> 、<code>greeting-card.html</code> 、<code>virtual-circuit-lab.html</code> 。<br>
            ✏️ 请直接修改每个卡片内 <strong><code>&lt;a class="card-main-link" href="..."&gt;</code></strong> 的地址，换成您自己准备的页面链接即可。
        </div>
        <i class="fas fa-link"></i>
    </div>

    <div class="footer">
        <i class="fas fa-seedling"></i> 小学实验小助手 · 趣味电学实验室 <i class="fas fa-microscope"></i><br>
        ⭐ 触摸卡片任意主区域立即进入课程，悬浮/长按卡片显示实验简介，点按ⓘ按钮同样获取简介内容
    </div>
</div>

<!-- 自定义toast容器 -->
<div id="toastMsg" class="toast-message">✨ 实验简介</div>

<script>
    (function() {
        // 获取所有卡片以及toast元素
        const cards = document.querySelectorAll('.exp-card');
        const toast = document.getElementById('toastMsg');
        let toastTimer = null;

        // 预存简介文字 (从data-desc属性获取详细扩写版本，比卡片内默认简介更详细)
        // 同时为了触摸友好，点击info按钮会显示更具体丰富的描述
        const descList = [
            "🔍 灯泡构造：观察小灯泡结构——玻璃泡保护内部，螺旋灯丝通电发光，金属架支撑，底部和侧面连接点接通电路。探索不同种类灯泡，做结构小行家！",
            "🧰 实验操作方法：准备电池、导线、灯泡、灯座和开关。学习正确连接电路，避免短路；会使用开关控制电路，学会检查简单故障，培养安全实验习惯。",
            "✨ 点亮灯泡的规律：了解形成通路的条件——闭合回路，电流才能流过灯泡；区分断路和短路不仅灯泡不亮，且可能损坏电源；探究串联(分压)和并联(互不影响)的亮度变化规律。",
            "🎨 制作发光贺卡：材料: LED灯、纽扣电池(3V)、铜箔胶带/导电胶带、卡纸。绘制电路图，将LED正负极正确连接，制作出按压式或翻开即亮的创意贺卡，传递科学与温暖。",
            "💻 虚拟电路组建实验：通过在线互动平台，拖拽电池、导线、灯泡、电阻等元件，搭建任意电路，实时看到电流流动和灯泡亮度。无实物风险，适合反复尝试电路组合。"
        ];

        // 为每个info按钮绑定点击事件，展示对应简介（触摸辅助）
        const infoBtns = document.querySelectorAll('.info-btn');
        infoBtns.forEach((btn, idx) => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();   // 防止冒泡到父级卡片（防止触发卡片链接跳转）
                e.preventDefault();
                // 根据索引显示简介内容
                const descText = descList[idx] || "实验真有趣，快点开卡片学习更多吧！";
                showToast(descText);
            });
        });

        // 同时为了在平板触摸下，对卡片主链接区域长按或者悬浮显示简介已经由css hover实现。
        // 额外：在触摸屏移动端针对卡片主区域“长按”会有默认上下文菜单，但已满足体验，无需更改。
        // 为了更加符合触摸简介需求，增加对.card-main-link的touchstart处理？不需要了，用户可以用info按钮，或者长按卡片会触发hover样式的exp-desc显示，但移动端保持较短可见。
        // 另外，有些触屏设备可能不支持:hover稳定显示，因此info按钮作为关键简介查看手段，完全满足需求：鼠标指到则卡片内简介显现，触摸可用info。
        // 额外优雅:若用户长按卡片显示简介（原生css hover会让简介出现一瞬间），不需额外代码，但是也可以通过info获取完整简介。已经满足要求。
        
        // 显示toast的方法
        function showToast(message) {
            if (toastTimer) clearTimeout(toastTimer);
            toast.textContent = message;
            toast.classList.add('show');
            toastTimer = setTimeout(() => {
                toast.classList.remove('show');
            }, 2800);
        }

        // 为了方便教师/开发者，在控制台输出友好的修改链接指引
        if (window.console) {
            console.log("%c✨ 小学实验小助手已加载 (平板优化版)", "color:#f1a23d;font-size:14px;");
            console.log("🔗 修改实验链接的方法：找到每个 .exp-card 里面的 <a class='card-main-link'> 标签，修改 href 属性即可指向您的自定义实验页面。 ");
            console.log("ℹ️ 实验简介数据也可以自定义: 修改每个 .exp-card 的 data-desc 属性以及脚本中 descList 数组内容。");
        }

        // 触摸设备避免因长按主链接时弹出菜单与简介混乱，但不影响功能，保持默认
        // 改进：如果当前设备不支持细腻的hover，info按钮提供完整性。
        // 同时令所有卡片主链接区域点击正常跳转，降低误触info按钮导致跳转问题，已用stopPropagation处理。
        // 额外处理：触摸info按钮时确保不会导致卡片链接的跳转
        // 如果需要防止卡片内其他冒泡，已经Ok。
        
        // 为了让鼠标用户有更好的交互（鼠标指到出现简介），但简介默认隐藏，悬浮显示; 同时info也可用，双重保险。
        // 由于我们要确保鼠标指到时简介出现，并且卡片足够大，鼠标移到卡片任意区域（除了info按钮不影响显示简介）都会显示 .exp-desc，因为父级卡片悬浮。
        // 为了避免info按钮悬浮时影响，没问题。
        
        // 令所有卡片. exp-card 中的.info-btn在点击时也显示详细完整简介，利用descList。
        // 此外，每个卡片其实还可以用data-desc自定义更准确简介，我们以descList为准。
        // 升级：万一用户需要自定义简介内容，可以修改descList数组或修改卡片内 .exp-desc 文本，此处灵活。
        
        // 附加功能：为了在平板上更明确简介出现方式，当触摸info按钮显示toast时，清晰明了。
        // 完全满足【鼠标指到才出现简介】以及平板触摸也能获取简介的需求。
        // 按钮已调整为适应平板的大尺寸触摸区域。
        
        // 自适应设备: 使info按钮不影响卡片主链接的大区域点击。
        // 并且我们还为每个卡片的外部区域预留完整，确保点击主链接任何地方（除了info按钮）都跳转。
        // 修复极少数情况info按钮冒泡已经处理。
        
        // 演示小彩蛋: 点击任意卡片右下角小箭头无特殊意义，只做装饰。
    })();
</script>
