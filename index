    <!-- 五个实验卡片 (大按钮 + 独立简介按钮) -->
    <div class="experiment-grid">
        <!-- 1：灯泡构造 -->
        <div class="exp-card" data-desc="🔍 了解小灯泡的玻璃泡、灯丝、金属架和连接点，观察内部构造图，认识常见灯泡种类，成为小小零件专家！">
            <a href="bulb-structure.html" class="card-main-link" id="link1">
                <div class="exp-icon"><i class="fas fa-lightbulb"></i></div>
